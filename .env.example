# ============================================================
# Cashinho — exemplo de configuração
# Copie para .env e ajuste. NUNCA versione o .env real.
# ============================================================

# Modo de operação.
# Valores: RESEARCH | BACKTEST | REPLAY | PAPER | ASSISTED | LIVE
# Padrao: PAPER. LIVE nao esta implementado e e bloqueado em runtime.
CASHINHO_MODE=PAPER

# Banco de dados (SQLite local). Caminho relativo a raiz do projeto.
CASHINHO_DATABASE_URL=sqlite:///data/cashinho.db

# Logging: DEBUG | INFO | WARNING | ERROR
CASHINHO_LOG_LEVEL=INFO
# Formato: json (producao/auditoria) ou console (desenvolvimento)
CASHINHO_LOG_FORMAT=console

# Fuso de exibicao. Interno sempre UTC.
CASHINHO_DISPLAY_TIMEZONE=America/Sao_Paulo

# Capital de referencia para dimensionamento (R$)
CASHINHO_CAPITAL=100000.00

# ------------------------------------------------------------
# Credenciais de provedores e corretora.
# Ainda NAO utilizadas nesta fase. Mantidas apenas como referencia
# de nomes. Nunca preencher valores reais neste arquivo de exemplo.
# ------------------------------------------------------------
# CASHINHO_GENIAL_ACCOUNT=
# CASHINHO_MARKET_DATA_API_KEY=
