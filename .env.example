# Copie para .env e preencha. O .env NUNCA vai para o repositorio.

# --- qual provedor serve cada finalidade -------------------------------------
# historico: backtest, pesquisa, validacao. Opcoes: demo | csv | brapi | yahoo
MARKET_DATA_HISTORICAL_PROVIDER=demo
# tempo real: scanner intradiario, paper trading ao vivo.
# Vazio = nao configurado, e o Cashinho BLOQUEIA analise de tempo real.
MARKET_DATA_REALTIME_PROVIDER=

# --- brapi.dev ---------------------------------------------------------------
# Token da sua conta. Sem token, a brapi atende apenas alguns ativos de teste.
BRAPI_TOKEN=
BRAPI_BASE_URL=https://brapi.dev/api

# ATENCAO - preencha os tres campos abaixo com os numeros do SEU plano, lidos
# na documentacao da brapi. O Cashinho nao adivinha caracteristica de plano:
# sem estes valores ele assume o pior caso (atraso desconhecido = nao serve
# para tempo real).
#
# Atraso tipico do seu plano, em segundos (ex.: 900 para 15 min, 1800 para 30).
BRAPI_ATRASO_SEGUNDOS=
# Timeframes que o SEU plano entrega, separados por virgula (ex.: 1d,1wk,1mo).
BRAPI_TIMEFRAMES=
# Teto de requisicoes por minuto que voce quer respeitar.
BRAPI_REQUISICOES_POR_MINUTO=

# --- MetaTrader 5 / Genial (tempo real, SOMENTE LEITURA) ---------------------
# Para usar: instale o MetaTrader da Genial, abra e autentique MANUALMENTE, e
# deixe o terminal aberto. O Cashinho conecta no terminal ja autenticado.
#
# NAO ha senha, assinatura eletronica nem numero de conta aqui - e nao deve
# haver. O Cashinho nunca guarda credencial da corretora.
MARKET_DATA_REALTIME_PROVIDER=metatrader

# Caminho do terminal. Vazio = deixa o MT5 achar sozinho. Preencha so quando
# houver mais de um MetaTrader instalado na maquina.
MT5_TERMINAL_PATH=

# Fuso em que o servidor da corretora marca as horas. Para a Genial e' o
# horario de Brasilia - e' o que impede o deslocamento de 3 horas.
MT5_SERVER_TIMEZONE=America/Sao_Paulo

# Segundos sem tick novo, DENTRO do pregao, para o feed virar STALE.
MT5_STALE_SECONDS=60

# Intervalo de atualizacao da tela em modo acompanhamento.
MT5_REFRESH_SECONDS=5
